# ---------------------------------------------------------------------------
# BioSynthetica - OPTIONAL server-side settings. Copy to .env only if needed.
#
# The web app (server.py) does NOT use API keys from this file. Every user types
# their own Groq / Gemini / NVIDIA keys in the browser; keys are sent only with
# that user's requests and are never stored on the server.
#
# The keys below are read ONLY by the command-line tools (research_engine.py,
# research_pipeline.py, research_planner.py, adversarial_critic.py, main.py),
# or by the web app if you explicitly set ALLOW_SERVER_KEYS=1 on a private,
# single-user machine. Never set ALLOW_SERVER_KEYS=1 on a public/shared host.
# ---------------------------------------------------------------------------
GROQ_API_KEY=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
GEMINI_API_KEY=AQ.Ab8RN6LgvOlgX4hvuDnMu00CcHQjcEHtHLfAvlBtMp2EyP1xKw
NVIDIA_NIM_API_KEY=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
ALLOW_SERVER_KEYS=0

# Free, no key needed - but Unpaywall requires a real contact email (CLI only;
# web users enter their own in the sidebar).
UNPAYWALL_EMAIL=

# Optional free literature-API keys (CLI; web users can enter their own in the sidebar)
OPENALEX_API_KEY=          # openalex.org/settings/api - free daily allowance (~1,000 searches)
S2_API_KEY=                # semanticscholar.org/product/api - dedicated 1 req/s quota

# Optional: raises NCBI E-utilities limit from 3 to 10 requests/second (free).
NCBI_API_KEY=

# Optional model overrides
# GROQ_REASONING_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b
# EMBED_MODEL=BAAI/bge-small-en-v1.5        # or sentence-transformers/all-MiniLM-L6-v2
# EMBED_BACKEND=hashing                     # force the offline embedder
# VECTOR_STORE_PATH=vector_store
# HOST=127.0.0.1
# PORT=8000
